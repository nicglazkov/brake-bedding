<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Only the window background from before the first Compose frame is here. Compose
      sets the colors of all other content. This value must stay near the Compose
      surface color. Then there is no light flash between the splash screen and the
      first frame.
    -->
    <color name="window_background">#FFFBF8F6</color>
    <color name="splash_background">#FF7A2E0B</color>
</resources>
