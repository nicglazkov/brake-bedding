# Build output
build/
.gradle/
.cxx/
.externalNativeBuild/
captures/
*.apk
*.aab
*.ap_

# Local machine configuration
local.properties
.DS_Store

# Signature data. The keystore stays out of the repository. These rules are a second
# protection if a keystore appears in the project folder.
keystore.properties
*.jks
*.keystore
*.p12

# NOTE: do not add a *.pro rule here. It applies to app/proguard-rules.pro, which is
# a source file that the release build uses. Its absence shows only much later, as an
# unserviceable minified build.

# IDE
*.iml
.idea/
!.idea/codeStyles/

# Session data
.remember/
