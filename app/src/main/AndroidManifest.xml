<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The speed comes from GPS. That is possible only with the fine location
         permission. The coarse permission is also declared. Then the dialog can show
         the approximate option, and the app can tell the user why it is not
         sufficient. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Vibration cues for the instructions. Android gives this permission at
         installation. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The run continues when the driver gets a call or when the screen goes off.
         A foreground service of the location type keeps the run loop alive. Its
         notification shows the applicable instruction. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      GPS is necessary, not optional. The full function of the app is a reaction to
      the ground speed. On a device without GPS, the app has no use. Play does not
      show the app to those devices. That is the intended result.
    -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="true"
        tools:ignore="UnnecessaryRequiredFeature" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BrakeBedding">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.BrakeBedding.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.RunService"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>

</manifest>
